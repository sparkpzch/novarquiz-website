# ============================================
# NovarQuiz Environment Variables
# Copy this file to .env.local and fill in values
# ============================================

# --- Firebase Realtime Database ---
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# --- Docker PostgreSQL ---
DB_PROVIDER=docker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=novarquiz_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/novarquiz_db
PORT=3000

# --- Firebase Client SDK (public, safe for browser) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Firebase Admin SDK (server-side only) ---
FIREBASE_SERVICE_ACCOUNT_KEY=novartis-decisionlab-firebase-adminsdk-fbsvc-5a3233811b.json

# --- Session Management ---
# Session cookie signing secret (min 32 chars, keep private, rotate it in production)
SESSION_SECRET=your_32_character_random_secret_string_here

# --- Firebase Storage ---
FIREBASE_STORAGE_URL=gs://novartis-decisionlab.firebasestorage.app
FIREBASE_STORAGE_PROFILE_FOLDER=gs://novartis-decisionlab.firebasestorage.app/Users/Profile Pictures
