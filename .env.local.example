# Copy this file to .env.local and fill in values
# Used by: npm run dev:docker, npm run migrate

# Database - Docker PostgreSQL
DB_PROVIDER=docker
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/novarquiz_db

# Firebase Client SDK
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Firebase Admin SDK
# Choose one local development credential strategy:
# 1. Recommended: paste the full JSON into FIREBASE_SERVICE_ACCOUNT_JSON
# 2. Alternative: point GOOGLE_APPLICATION_CREDENTIALS to a JSON key outside the repo
# 3. Last resort: point FIREBASE_SERVICE_ACCOUNT_KEY to a JSON key outside the repo
FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# FIREBASE_SERVICE_ACCOUNT_KEY=/absolute/path/to/service-account.json

# Optional server-side Firebase config for Admin SDK.
# Falls back to NEXT_PUBLIC_* when omitted.
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_DATABASE_URL=

# Session
SESSION_SECRET=your_32_character_random_secret_string_here

# Rate limiting — Upstash Redis (optional, recommended for production)
# When set, rate limits are enforced across all instances via Redis sliding window.
# When unset, falls back to in-process counting (per-instance, fine for local dev).
# Create a free database at https://console.upstash.com/ → Redis → REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Insight summary drafting — Google Gemini (optional)
# Used ONLY in the admin CMS to draft wording for /stats insight summaries.
# Player answers are never sent: the prompt is built from quiz content an admin
# wrote, which is what makes the free tier acceptable here (Google may train on
# free-tier traffic). Leave unset to disable the "Draft with Gemini" button.
# Get a key at https://aistudio.google.com/apikey
#
# Free tier requires a project with NO prepay billing attached. A project that
# has been switched to prepay returns 429 RESOURCE_EXHAUSTED ("prepayment
# credits are depleted") once its balance hits zero, free tier or not.
GEMINI_API_KEY=
# Optional model override. Defaults to the alias gemini-flash-lite-latest.
# Prefer an alias over a pinned id — pinned ids are retired for new users
# (gemini-2.5-flash-lite already 404s; the current pinned lite model is
# gemini-3.5-flash-lite).
# GEMINI_MODEL=
