{
  "apphosting": [
    {
      "backendId": "novarquiz-website-sg",
      "rootDir": "/",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "functions"
      ]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Novarquiz",
        "supportEmail": "Novartis@novartis-decisionlab.firebaseapp.com"
      }
    }
  }
}
