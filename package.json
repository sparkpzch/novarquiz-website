{
  "name": "novarquiz-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.2.0",
  "scripts": {
    "dev": "dotenv -e .env.neon -- next dev",
    "dev:docker": "dotenv -e .env.local -- next dev",
    "dev:neon": "dotenv -e .env.neon -- next dev",
    "build": "next build",
    "analyze": "ANALYZE=true next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "lint:ci": "node scripts/ci/check-lint.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'lib/**/*.test.ts'",
    "set-admin": "tsx scripts/admin/set-admin.ts",
    "migrate": "dotenv -e .env.local -- tsx scripts/db/migrate.ts",
    "migrate:neon": "dotenv -e .env.neon -- tsx scripts/db/migrate.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@neondatabase/serverless": "^1.1.0",
    "@tanstack/react-query": "^5.100.6",
    "@tanstack/react-virtual": "^3.13.24",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@xyflow/react": "^12.10.2",
    "dotenv": "^17.4.2",
    "firebase": "^12.12.1",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.18.0",
    "i18next": "^24.0.0",
    "jose": "^6.2.2",
    "motion": "^12.38.0",
    "next": "^16.2.6",
    "pg": "^8.13.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "^15.0.0",
    "react-qr-code": "^2.0.18",
    "sharp": "^0.34.5",
    "ws": "^8.20.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.4",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.100.6",
    "@types/node": "^20",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
