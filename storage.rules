rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Profile pictures: owner can write/delete, public read
    match /Users/{folder}/{uid} {
      allow read: if true;
      allow write: if request.auth != null
                   && folder == 'Profile Pictures'
                   && request.auth.token.firebase.sign_in_provider != 'anonymous'
                   && request.auth.token.email_verified == true
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && folder == 'Profile Pictures'
                   && request.auth.uid == uid;
    }

    // Quiz media uploaded via the server API (Admin SDK only).
    // Clients may read (public CDN); all writes and deletes are server-side.
    match /quiz-media/{fileName} {
      allow get: if !fileName.matches('original-.*');
      allow list: if false;
      allow write: if false;
      allow delete: if false;
    }

    // Legacy path — same policy as quiz-media
    match /question-sessions/{allPaths=**} {
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }
  }
}
