{
  "rules": {
    "sessions": {
      "$sessionId": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('hostId').val() === auth.uid) || (data.exists() && data.child('hostId').val() === auth.uid))",
        "status": {
          ".validate": "newData.isString() && (newData.val() === 'waiting' || newData.val() === 'started' || newData.val() === 'ended')"
        },
        "hostId": {
          ".validate": "newData.isString()"
        },
        "leaderId": {
          ".validate": "newData.isString() || !newData.exists()"
        },
        "joinToken": {
          ".validate": "newData.isString() || !newData.exists()"
        },
        "currentQuestionId": {
          ".validate": "newData.isString() || !newData.exists()"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['displayName', 'joinedAt']) || !newData.exists()"
          }
        },
        "scores": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "!newData.exists() || newData.hasChildren(['displayName', 'updatedAt'])",
            "score": {
              ".validate": "data.exists() ? newData.val() === data.val() : (newData.val() === 0)"
            },
            "displayName": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "updatedAt": {
              ".validate": "newData.isNumber()"
            },
            "finished": {
              ".validate": "newData.isBoolean()"
            },
            "currentQuestionId": {
              ".validate": "newData.isString() || !newData.exists()"
            },
            "currentQuestionLabel": {
              ".validate": "newData.isString() || !newData.exists()"
            }
          }
        }
      }
    },
    "teamRooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('hostId').val() === auth.uid) || (data.exists() && data.child('hostId').val() === auth.uid))",
        "pin": {
          ".read": "false"
        },
        "hostId": {
          ".validate": "newData.isString()"
        },
        "sessionId": {
          ".validate": "newData.isString()"
        },
        "status": {
          ".validate": "newData.isString() && (newData.val() === 'waiting' || newData.val() === 'started' || newData.val() === 'ended')"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "scores": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            "score": {
              ".validate": "data.exists() ? newData.val() === data.val() : (newData.val() === 0)"
            }
          }
        }
      }
    },
    "joinTokens": {
      "$token": {
        ".read": "auth != null",
        ".write": "auth != null && ((!newData.exists() && data.exists() && auth.uid === root.child('sessions').child(data.child('sessionId').val()).child('hostId').val()) || (newData.exists() && auth.uid === root.child('sessions').child(newData.child('sessionId').val()).child('hostId').val()))"
      }
    },
    "userSessions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
