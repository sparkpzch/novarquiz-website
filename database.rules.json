{
  "rules": {
    "sessions": {
      "$sessionId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "status": {
          ".validate": "newData.isString() && (newData.val() === 'waiting' || newData.val() === 'started' || newData.val() === 'ended')"
        },
        "hostId": {
          ".validate": "newData.isString()"
        },
        "leaderId": {
          ".validate": "newData.isString()"
        },
        "joinToken": {
          ".validate": "newData.isString() || !newData.exists()"
        },
        "currentQuestionId": {
          ".validate": "newData.isString() || !newData.exists()"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['displayName', 'joinedAt']) || !newData.exists()"
          }
        },
        "scores": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    "teamRooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "hostId": {
          ".validate": "newData.isString()"
        },
        "sessionId": {
          ".validate": "newData.isString()"
        },
        "pin": {
          ".validate": "newData.isString()"
        },
        "status": {
          ".validate": "newData.isString() && (newData.val() === 'waiting' || newData.val() === 'started' || newData.val() === 'ended')"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "scores": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    "joinTokens": {
      "$token": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
