{
  "rules": {
    "sessions": {
      "$sessionId": {
        ".read": "auth != null && (data.child('hostId').val() === auth.uid || (data.child('players').child(auth.uid).exists() && data.child('players').child(auth.uid).child('left').val() !== true))",
        ".write": false,
        "status": {
          ".validate": "newData.isString() && (newData.val() === 'waiting' || newData.val() === 'started' || newData.val() === 'ended')"
        },
        "hostId": {
          ".validate": "newData.isString()"
        },
        "leaderId": {
          ".validate": "newData.isString() || !newData.exists()"
        },
        "joinToken": {
          ".validate": "newData.isString() || !newData.exists()"
        },
        "currentQuestionId": {
          ".validate": "newData.isString() || !newData.exists()"
        },
        "players": {
          "$uid": {
            ".write": false,
            ".validate": "newData.hasChildren(['displayName', 'joinedAt']) || !newData.exists()"
          }
        },
        "scores": {
          "$uid": {
            ".write": false,
            ".validate": "!newData.exists() || newData.hasChildren(['displayName', 'updatedAt'])",
            "score": {
              ".validate": "data.exists() ? newData.val() === data.val() : (newData.val() === 0)"
            },
            "displayName": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "updatedAt": {
              ".validate": "newData.isNumber()"
            },
            "finished": {
              ".validate": "newData.isBoolean()"
            },
            "currentQuestionId": {
              ".validate": "newData.isString() || !newData.exists()"
            },
            "currentQuestionLabel": {
              ".validate": "newData.isString() || !newData.exists()"
            }
          }
        },
        "connections": {
          "$uid": {
            "$connectionId": {
              "$transportId": {
                ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('sessions').child($sessionId).child('players').child($uid).child('connectionId').val() === $connectionId)",
                ".validate": "newData.val() === true || !newData.exists()"
              }
            }
          }
        }
      }
    },
    "teamRooms": {
      "$roomId": {
        ".read": "auth != null && !data.child('pin').exists() && !data.child('joinAttempts').exists() && (data.child('hostId').val() === auth.uid || data.child('players').child(auth.uid).exists())",
        ".write": false,
        "hostId": {
          ".validate": "newData.isString()"
        },
        "sessionId": {
          ".validate": "newData.isString()"
        },
        "status": {
          ".validate": "newData.isString() && (newData.val() === 'waiting' || newData.val() === 'started' || newData.val() === 'ended')"
        },
        "players": {
          "$uid": {
            ".write": false
          }
        },
        "scores": {
          "$uid": {
            ".write": false,
            "score": {
              ".validate": "data.exists() ? newData.val() === data.val() : (newData.val() === 0)"
            }
          }
        }
      }
    },
    "joinTokens": {
      "$token": {
        ".read": "auth != null",
        ".write": false
      }
    },
    "userSessions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$entryId": {
          ".write": "auth != null && auth.uid === $uid && !data.child('connectionId').exists() && !newData.child('connectionId').exists()"
        }
      }
    },
    "teamRoomSecrets": {
      ".read": false,
      ".write": false
    },
    "uploadQuotas": {
      ".read": false,
      ".write": false
    },
    "uploadReservations": {
      ".read": false,
      ".write": false
    }
  }
}
